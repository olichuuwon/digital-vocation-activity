# Supabase (M0.5). Never commit real values: put them in .env.local (git-ignored).
# Project Settings > API: the project URL and the publishable (anon) key. Never the secret/service_role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional, development only: route group play through the local WebSocket relay instead of
# Supabase Realtime (`node e2e/groupRelay.ts`). Playwright sets this for e2e builds.
# VITE_GROUP_RELAY_URL=ws://localhost:4174
